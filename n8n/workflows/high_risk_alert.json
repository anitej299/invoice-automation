{
  "name": "High-risk finance alerts",
  "nodes": [
    {
      "id": "schedule---risk-check",
      "name": "Schedule - Risk Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "backend---reserve-notifications",
      "name": "Backend - Reserve Notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/automation/notifications/claim?kind=risk",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "id": "loop---each-notification",
      "name": "Loop - Each Notification",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "gmail---send-risk-alert",
      "name": "Gmail - Send Risk Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        750,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.recipient }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.message }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "backend---acknowledge-delivery",
      "name": "Backend - Acknowledge Delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/api/automation/notifications/{{ $('Loop - Each Notification').item.json.id }}/sent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 180000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {delivery_id: $json.id} }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "log---delivery-uncertain",
      "name": "Log - Delivery Uncertain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "console.error('Delivery is unacknowledged. Check Gmail Sent and the reserved reminder before attempting a manual resend.'); return $input.item;"
      }
    }
  ],
  "connections": {
    "Schedule - Risk Check": {
      "main": [
        [
          {
            "node": "Backend - Reserve Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend - Reserve Notifications": {
      "main": [
        [
          {
            "node": "Loop - Each Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop - Each Notification": {
      "main": [
        [],
        [
          {
            "node": "Gmail - Send Risk Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Send Risk Alert": {
      "main": [
        [
          {
            "node": "Backend - Acknowledge Delivery",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log - Delivery Uncertain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend - Acknowledge Delivery": {
      "main": [
        [
          {
            "node": "Loop - Each Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log - Delivery Uncertain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log - Delivery Uncertain": {
      "main": [
        [
          {
            "node": "Loop - Each Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {},
  "tags": []
}
